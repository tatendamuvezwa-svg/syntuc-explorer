rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Syntuc Explorer accesses Firestore exclusively through server API routes.
    // The server uses Firebase Admin SDK with IAM/service identity and enforces
    // authorization in route middleware. Admin SDK requests bypass these rules.
    // Deny all direct client SDK access so private guest/reservation/analytics/media
    // collections cannot be read or modified from an untrusted browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

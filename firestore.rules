rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check collection
    match /healthcheck/{docId} {
      allow read, write: if true;
    }

    // Reservation requests
    match /reservation_requests/{reservationId} {
      allow read, write: if true;
    }

    // Reservation items
    match /reservation_items/{itemId} {
      allow read, write: if true;
    }

    // Analytics visitors
    match /analytics_visitors/{visitorId} {
      allow read, write: if true;
    }

    // Analytics sessions
    match /analytics_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Analytics events
    match /analytics_events/{eventId} {
      allow read, write: if true;
    }

    // Media assets
    match /media_assets/{mediaId} {
      allow read, write: if true;
    }

    // Media chunks
    match /media_chunks/{chunkId} {
      allow read, write: if true;
    }

    // Products & Packages
    match /products/{productId} {
      allow read, write: if true;
    }

    match /packages/{packageId} {
      allow read, write: if true;
    }

    // Taxonomy & Metadata
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /operators/{operatorId} {
      allow read, write: if true;
    }

    match /properties/{propertyId} {
      allow read, write: if true;
    }

    match /rooms/{roomId} {
      allow read, write: if true;
    }

    match /knowledge_sources/{sourceId} {
      allow read, write: if true;
    }

    // Reviews & Notes
    match /boat_cruise_reviews/{reviewId} {
      allow read, write: if true;
    }

    match /coordinator_notes/{noteId} {
      allow read, write: if true;
    }

    match /leads/{leadId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /product_revisions/{revId} {
      allow read, write: if true;
    }

    // Deleted record tombstones
    match /deleted_records/{tombstoneId} {
      allow read, write: if true;
    }

    // Guests
    match /guests/{guestId} {
      allow read, write: if true;
    }

    // Guest access tokens
    match /guest_access_tokens/{tokenId} {
      allow read, write: if true;
    }

    // Guest messages
    match /guest_messages/{messageId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
